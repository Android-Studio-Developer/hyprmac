<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Windows window manager. Builds on any OS (EnableWindowsTargeting), runs on Windows 10/11. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>hyprwin</AssemblyName>
    <RootNamespace>Hyprwin</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <NoWarn>$(NoWarn);SYSLIB1054;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hyprwin.Core/Hyprwin.Core.csproj" />
    <ProjectReference Include="../Hyprwin.Shell/Hyprwin.Shell.csproj" />
  </ItemGroup>

</Project>
