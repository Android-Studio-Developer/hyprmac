<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-free core of hyprwin: config parser, Lua configs, layouts, workspaces, rices.
       Port of Sources/HyprmacCore (Swift); keep behavior in sync. Builds and tests on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Hyprwin.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="KeraLua" Version="1.4.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Same hl.* shim as the macOS build. -->
    <EmbeddedResource Include="../../../shared/hl-prelude.lua" LogicalName="hl-prelude.lua" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hyprwin.Core.Tests" />
  </ItemGroup>

</Project>
