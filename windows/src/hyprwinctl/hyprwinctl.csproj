<Project Sdk="Microsoft.NET.Sdk">

  <!-- Console companion to hyprwin.exe (a GUI app terminals don't wait for): talks to the running
       window manager over a named pipe, and runs `rice`, `check-config` and `list` directly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Hyprwin.Core/Hyprwin.Core.csproj" />
    <ProjectReference Include="../Hyprwin/Hyprwin.csproj" />
  </ItemGroup>

</Project>
